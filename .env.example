ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-chat-latest

VERTEXAI_API_KEY=your_vertexai_api_key
VERTEXAI_BASE_URL=https://LOCATION-aiplatform.googleapis.com/v1beta1/projects/PROJECT_ID/locations/LOCATION/endpoints/openapi
VERTEXAI_MODEL=google/gemini-2.5-flash-lite

AZURE_API_KEY=your_azure_api_key
AZURE_API_ENDPOINT=https://ENDPOINT.openai.azure.com
AZURE_API_DEPLOYMENT=YOUR_DEPLOYMENT
AZURE_API_VERSION=2024-05-01-preview
AZURE_API_MODEL_NAME=gpt-5-mini

GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id

# Use an absolute path to your local Google service account credentials JSON.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-api-key.json

